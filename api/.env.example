# Used by docker-compose.yaml to configure the db and app services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=houses

# Host port for the API. Change it if 8000 is already in use.
API_PORT=8000

# Used when running the API directly with `uv run`, outside Docker Compose.
# Needs a Postgres server reachable on localhost:5432.
DB_CONN=postgresql+psycopg://postgres:postgres@localhost:5432/houses
